FROM python:3.12


WORKDIR /app

COPY requirements.txt .

RUN apt-get update && apt-get install -y docker.io && pip install --no-cache-dir -r requirements.txt

COPY . .



ENV PYTHONUNBUFFERED=1

CMD echo "===  START DATA INSERTION ===" && \
    python -u -m SCRIPTS.insert_by_operational_flights && \
    echo "Installing docker-cli..." && \
    echo "Restarting the afklm_mongodb container"  &&   \
    docker restart afklm_mongodb && \
    echo "=== DATA INSERTED ===" || \
    echo "=== INSERTION ERROR ==="  
