FROM python:3.12


WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY . .



ENV PYTHONUNBUFFERED=1

CMD echo "===  START DATA INSERTION ===" && \
    python -u -m SCRIPTS.insert_by_operational_flights && \
    echo "=== DATA INSERTED ===" || \
    echo "=== INSERTION ERROR ==="
