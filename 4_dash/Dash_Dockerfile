FROM python:3.12-slim

COPY ./dash_requirements.txt ./dash_requirements.txt

RUN apt-get update && apt-get -y install curl && pip install --upgrade pip && pip install -r dash_requirements.txt  && pip install uvicorn fastapi & pip install --trusted-host pypi.python.org gunicorn

RUN rm dash_requirements.txt
COPY ./ihm_dash_test2.py ./ihm_dash_test2.py


EXPOSE 8002

CMD ["gunicorn", "ihm_dash_test2:app", "-b :8002"]