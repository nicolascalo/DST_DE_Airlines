FROM python:3.12-slim

COPY ./afklm_ml_api_requirements.txt ./afklm_ml_api_requirements.txt

RUN apt-get update && apt-get -y install curl && pip install --upgrade pip && pip install -r afklm_ml_api_requirements.txt  && pip install uvicorn fastapi
RUN rm afklm_ml_api_requirements.txt
COPY ./outputs ./outputs
COPY ./config ./config
COPY ./afklm_ml_api_local.py ./afklm_ml_api_local.py


EXPOSE 8001

CMD ["uvicorn", "afklm_ml_api_local:api", "--host", "0.0.0.0", "--port", "8001"]