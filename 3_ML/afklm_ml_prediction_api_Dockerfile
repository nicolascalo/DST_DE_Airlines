FROM python:3.12-slim

COPY ./afklm_ml_prediction_api_requirements.txt ./afklm_ml_prediction_api_requirements.txt

RUN apt-get update && pip install --upgrade pip && pip install -r afklm_ml_prediction_api_requirements.txt  && pip install uvicorn fastapi
RUN rm afklm_ml_prediction_api_requirements.txt
COPY ./outputs/best_models ./outputs/best_models
COPY ./config ./config
COPY ./afklm_ml_prediction_api.py ./afklm_ml_prediction_api.py


EXPOSE 8001

CMD ["uvicorn", "afklm_ml_prediction_api:api", "--host", "0.0.0.0", "--port", "8001"]